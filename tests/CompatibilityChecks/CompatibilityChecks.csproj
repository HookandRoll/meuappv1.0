<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreSource Condition="'$(CoreSource)' == ''">../../src/Core</CoreSource>
    <VisualSource Condition="'$(VisualSource)' == ''">../../src/GodotApp</VisualSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CoreSource)/*.cs" />
    <Compile Include="$(VisualSource)/MapDetailIcons.cs" />
    <Compile Include="$(VisualSource)/GlobalDataTextures.cs" />
    <Compile Include="$(VisualSource)/OceanShelf.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="GodotSharp" Version="4.7.2" />
  </ItemGroup>
</Project>
